<Window x:Class="jeugdcrossdata.UI.ModernAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alert"
        Width="430"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#0E1423"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border Margin="10" Background="#17243D" CornerRadius="14" BorderBrush="#324A73" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#121D33" Padding="12,9" CornerRadius="14,14,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <TextBlock x:Name="TitleTextBlock" Text="Melding" Foreground="#E8EEF8" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="&#xE8BB;"
                            DockPanel.Dock="Right"
                            Width="30"
                            Height="24"
                            FontFamily="Segoe MDL2 Assets"
                            Foreground="#E8EEF8"
                            Background="#612E47"
                            BorderBrush="#91506F"
                            BorderThickness="1"
                            Cursor="Hand"
                            Padding="0"
                            Click="CloseButton_Click" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="18,16,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" CornerRadius="17" Background="#1B2D4A" VerticalAlignment="Top">
                    <TextBlock x:Name="IconGlyphTextBlock"
                               Text="&#xE946;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#71B1FF" />
                </Border>

                <TextBlock Grid.Column="2"
                           x:Name="MessageTextBlock"
                           Text="Bericht"
                           Foreground="#D8E4FA"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           FontSize="14" />
            </Grid>

            <Border Grid.Row="2" Background="#111C33" CornerRadius="0,0,14,14" Padding="0,0,0,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,18,0">
                    <Button Content="OK"
                            Width="84"
                            Height="34"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Background="#1E8BE6"
                            BorderBrush="#48A6FF"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="OkButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
