<Window x:Class="jeugdcrossdata.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Jeugd crosscompetitie"
        Height="700"
        Width="960"
        MinHeight="640"
        MinWidth="900"
        Background="#0E1423"
        WindowStyle="None"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#17243D" />
        <SolidColorBrush x:Key="CardEdgeBrush" Color="#324A73" />
        <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#AAB5CC" />
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="BorderBrush" Value="{StaticResource CardEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Background" Value="#111C33" />
            <Setter Property="BorderBrush" Value="#3E5682" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="ModernPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Background" Value="#111C33" />
            <Setter Property="BorderBrush" Value="#3E5682" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,10,10,0" />
            <Setter Property="Background" Value="#1E8BE6" />
            <Setter Property="BorderBrush" Value="#48A6FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#243A5E" />
            <Setter Property="BorderBrush" Value="#365988" />
        </Style>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Foreground" Value="#E8EEF8" />
            <Setter Property="Background" Value="#1B2D4A" />
            <Setter Property="BorderBrush" Value="#355785" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="CloseTitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Background" Value="#612E47" />
            <Setter Property="BorderBrush" Value="#91506F" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="#D8E4FA" />
            <Setter Property="Background" Value="#243A5E" />
            <Setter Property="BorderBrush" Value="#365988" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="#D8E4FA" />
            <Setter Property="Background" Value="#12203A" />
            <Setter Property="BorderBrush" Value="#3E5682" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      Margin="10,0,6,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      RecognizesAccessKey="True"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />

                                    <ToggleButton Grid.Column="1"
                                                  Focusable="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <TextBlock Text="&#xE70D;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11"
                                                   Foreground="#AAB5CC"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,2,0,0"
                                        Background="#111C33"
                                        BorderBrush="#3E5682"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                    <ScrollViewer SnapsToDevicePixels="True" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MainBorder" Property="Opacity" Value="0.65" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#48A6FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#F8FAFC" />
                        <Setter Property="Background" Value="#111C33" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#1E8BE6" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1E8BE6" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootContainer">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1220" Offset="0" />
                <GradientStop Color="#13203A" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#121D33" BorderBrush="#2D456D" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <DockPanel Margin="12,8">
                <TextBlock Text="Jeugd crosscompetitie" Foreground="#E8EEF8" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="ConfigToggleButton"
                            Content="&#xE713;"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="Toon/verberg configuratie"
                            Click="ConfigToggleButton_Click" />
                    <Button Content="&#xE921;" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click" />
                    <Button x:Name="MaximizeRestoreButton" Content="&#xE922;" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeRestoreButton_Click" />
                    <Button Content="&#xE8BB;" Style="{StaticResource CloseTitleBarButtonStyle}" Click="CloseButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Jeugd crosscompetitie"
                                   Foreground="White"
                                   FontSize="30"
                                   FontWeight="Bold" />
                        <TextBlock Text="Upload JSON-bestanden direct naar GitHub."
                                   Foreground="{StaticResource SecondaryForegroundBrush}"
                                   Margin="0,6,0,0"
                                   FontSize="14" />
                    </StackPanel>
                </Border>

                <Border x:Name="ConfigSection" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,16,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Configuratie (alleen-lezen in UI)" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="ConfigPathTextBlock"
                                   Foreground="{StaticResource SecondaryForegroundBrush}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="StaticSettingsTextBlock"
                                   Foreground="{StaticResource SecondaryForegroundBrush}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="Persoonlijke Access Token (PAT)" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock Text="PAT wordt versleuteld opgeslagen voor deze Windows-gebruiker."
                                   Foreground="{StaticResource SecondaryForegroundBrush}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                        <PasswordBox x:Name="PatPasswordBox" Style="{StaticResource ModernPasswordBoxStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SavePatButton"
                                    Content="PAT opslaan"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="SavePatButton_Click" />
                            <Button x:Name="TestPatButton"
                                    Content="Test PAT"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="TestPatButton_Click" />
                            <Button x:Name="ClearPatButton"
                                    Content="PAT verwijderen"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ClearPatButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="JSON bestand"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Doelbestand in repository"
                                   Foreground="{StaticResource SecondaryForegroundBrush}"
                                   Margin="0,10,0,0" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="RepositoryFileComboBox"
                                      Grid.Column="0"
                                      Margin="0"
                                      Style="{StaticResource ModernComboBoxStyle}">
                                <ComboBox.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#111C33" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#111C33" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#111C33" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F8FAFC" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F8FAFC" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1E8BE6" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
                                </ComboBox.Resources>
                            </ComboBox>
                            <Button x:Name="DownloadRepositoryFileButton"
                                    Grid.Column="2"
                                    Content="&#xE896;"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="Download geselecteerd bestand uit repository"
                                    Click="DownloadRepositoryFileButton_Click" />
                        </Grid>
                        <Border x:Name="DropArea"
                                Margin="0,14,0,0"
                                Padding="20"
                                BorderBrush="#5071A7"
                                BorderThickness="2"
                                CornerRadius="14"
                                Background="#12203A"
                                AllowDrop="True"
                                DragOver="DropArea_DragOver"
                                Drop="DropArea_Drop">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Sleep je JSON bestand hierheen"
                                           Foreground="#D8E4FA"
                                           HorizontalAlignment="Center"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="of gebruik Bestand kiezen"
                                           Foreground="{StaticResource SecondaryForegroundBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="SelectedFileTextBlock"
                                   Text="Nog geen bestand geselecteerd."
                                   Foreground="{StaticResource SecondaryForegroundBrush}"
                                   Margin="0,12,0,0" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BrowseButton"
                                    Content="Bestand kiezen"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseButton_Click" />
                            <Button x:Name="UploadButton"
                                    Content="Upload naar GitHub"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="UploadButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Status" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="StatusTextBlock"
                                   Text="Klaar."
                                   Foreground="{StaticResource SecondaryForegroundBrush}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>

