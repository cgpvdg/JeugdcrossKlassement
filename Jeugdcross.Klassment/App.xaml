<Application x:Class="Jeugdcross.Klassment.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ui:ThemesDictionary Theme="Light"/><ui:ControlsDictionary/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="CenteredTableText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="4,0"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="RowHeight" Value="38"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,8"/></Style>
 </ResourceDictionary></Application.Resources>
</Application>
