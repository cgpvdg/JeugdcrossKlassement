<ui:FluentWindow x:Class="Jeugdcross.Klassment.TeamBreakdownWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Puntopbouw" Width="1100" Height="760" MinWidth="850" MinHeight="560" WindowStartupLocation="CenterOwner" Background="#F5F7F8">
 <Grid Background="#F5F7F8"><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition/></Grid.RowDefinitions>
  <ui:TitleBar Title="Puntopbouw" ShowMinimize="False" ShowMaximize="True"/>
  <Grid Grid.Row="1" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="160"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="TeamHeading" FontSize="26" FontWeight="SemiBold" Foreground="#153C46"/>
   <TextBlock x:Name="TotalText" Grid.Row="1" FontSize="18" Margin="0,8,0,18"/>
   <TextBlock Grid.Row="2" Text="Ploegscore per wedstrijd · de twee laagste scores vormen het totaal" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <DataGrid x:Name="RaceScoresGrid" Grid.Row="3"><DataGrid.Columns><DataGridTextColumn Header="Wedstrijd" Binding="{Binding Race}" Width="*"/><DataGridTextColumn Header="Lopers" Binding="{Binding Runners}" Width="80"/><DataGridTextColumn Header="Punten" Binding="{Binding Points}" Width="80"/><DataGridTextColumn Header="Totaalberekening" Binding="{Binding Status}" Width="200"/></DataGrid.Columns></DataGrid>
   <TextBlock Grid.Row="4" Text="Lopers per wedstrijd · de drie laagste punten vormen de ploegscore" FontWeight="SemiBold" Margin="0,20,0,8"/>
   <DataGrid x:Name="RunnerScoresGrid" Grid.Row="5"><DataGrid.Columns><DataGridTextColumn Header="Wedstrijd" Binding="{Binding Race}" Width="*" MinWidth="200"/><DataGridTextColumn Header="Deelnemer" Binding="{Binding Name}" Width="*" MinWidth="150"/><DataGridTextColumn Header="Categorie" Binding="{Binding Category}" Width="135"/><DataGridTextColumn Header="Punten" Binding="{Binding Points}" Width="65"/><DataGridTextColumn Header="Tijd" Binding="{Binding Time}" Width="75"/><DataGridTextColumn Header="Ploegberekening" Binding="{Binding Status}" Width="180"/></DataGrid.Columns></DataGrid>
   <Button Grid.Row="6" Content="Sluiten" IsCancel="True" HorizontalAlignment="Right" Margin="0,16,0,0"/>
  </Grid>
 </Grid>
</ui:FluentWindow>
