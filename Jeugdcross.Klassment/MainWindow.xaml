<ui:FluentWindow x:Class="Jeugdcross.Klassment.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Jeugdcrosscompetitie regio 1 t/m 5" Width="1320" Height="850" MinWidth="1000" MinHeight="650" WindowStartupLocation="CenterScreen" Icon="Assets/app.ico" Background="#F5F7F8">
 <Grid Background="#F5F7F8"><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition/></Grid.RowDefinitions>
  <ui:TitleBar Title="Jeugdcrosscompetitie regio 1 t/m 5" ShowMinimize="True" ShowMaximize="True"/>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="#E9F0F2" Padding="20"><DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="Jeugdcrosscompetitie regio 1 t/m 5" FontSize="18" FontWeight="Bold" Foreground="#153C46" TextWrapping="Wrap" Margin="0,12,0,32"/>
     <ListBox x:Name="ConfigurationMenu" Background="Transparent" BorderThickness="0" SelectionChanged="ConfigurationSelected" Margin="0,0,0,16"><ListBoxItem Content="Configuratie" Padding="12"/><ListBoxItem Content="Reglement" Padding="12"/></ListBox>
     <TextBlock Text="POULE" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <ComboBox x:Name="PouleBox" SelectionChanged="PouleChanged" Margin="0,0,0,24"/>
     <ListBox x:Name="Menu" SelectionChanged="MenuChanged" BorderThickness="0" Background="Transparent" SelectedIndex="0">
      <ListBoxItem Content="Wedstrijden" Padding="12"/><ListBoxItem Content="Categorieën" Padding="12"/><ListBoxItem Content="Naamcontroles" Padding="12"/><ListBoxItem Content="Uitslagenlijst" Padding="12"/><ListBoxItem Content="Individueel klassement" Padding="12"/><ListBoxItem Content="Ploegenklassement" Padding="12"/><ListBoxItem Content="Exporteren" Padding="12"/>
     </ListBox>
    </StackPanel>
    <TextBlock Text="C.G.P. Software" VerticalAlignment="Bottom" FontWeight="SemiBold"/>
   </DockPanel></Border>
   <Grid x:Name="ContentArea" Grid.Column="1" Margin="32,20,32,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" FontSize="30" FontWeight="SemiBold" Foreground="#153C46"/>
    <TextBlock x:Name="Summary" Grid.Row="1" Margin="0,8,0,16" TextWrapping="Wrap" Foreground="#52636D"/>
    <Border Grid.Row="2" Background="#E1EEF1" CornerRadius="6" Padding="12" Margin="0,0,0,16"><TextBlock x:Name="Notice" TextWrapping="Wrap" Text="Kies een poule en importeer het eerste uitslagenbestand."/></Border>
    <Grid Grid.Row="3">
     <Grid x:Name="RacePanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <WrapPanel><Button x:Name="ImportResultsButton" Content="Uitslagen.nl importeren" Click="ImportTxt" Background="#0078D4" Foreground="White"/><Button Content="Wedstrijd bewerken" Click="EditRace"/><Button Content="Wedstrijd verwijderen" Click="DeleteRace"/><Button Content="Schoon beginnen" Click="StartClean" Background="#C62828" Foreground="White"/></WrapPanel>
      <TextBlock Grid.Row="1" Text="Importeer maximaal drie wedstrijden per poule. Een import met dezelfde datum vervangt de bestaande uitslag na bevestiging." TextWrapping="Wrap" Margin="0,6,0,20"/>
      <DataGrid x:Name="RaceGrid" Grid.Row="2"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" Header="Datum" Binding="{Binding Date,StringFormat=dd-MM-yyyy}" Width="130"/><DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" Header="Wedstrijd" Binding="{Binding Name}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" Header="Vereniging / plaats" Binding="{Binding Association}" Width="230"/><DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" Header="Uitslagen" Binding="{Binding Count}" Width="100"/></DataGrid.Columns></DataGrid>
     </Grid>
     <Grid x:Name="CategoriesPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="Selecteer een geïmporteerde categorie om de koppeling en naam aan te passen. De naam geldt voor deze categorie in de hele poule; de koppeling geldt voor de geselecteerde wedstrijd." TextWrapping="Wrap" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal" Margin="0,0,0,16"><TextBlock Text="Wedstrijd" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="CategoryRaceFilter" DisplayMemberPath="Name" SelectedValuePath="Key" Width="400" SelectionChanged="CategoryRaceChanged"/></StackPanel></StackPanel>
      <DataGrid x:Name="CategoryMappingGrid" Grid.Row="1" SelectionMode="Single" SelectionChanged="CategoryMappingSelected"><DataGrid.Columns>
       <DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" Header="Wedstrijd" Binding="{Binding Race}" Width="*" MinWidth="190"/>
       <DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" Header="Geïmporteerde categorie" Binding="{Binding Source}" Width="*" MinWidth="170"/>
       <DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" Header="Koppeling" Binding="{Binding Target}" Width="150"/>
       <DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" Header="Naam in applicatie" Binding="{Binding Name}" Width="*" MinWidth="150"/>
       <DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" Header="Uitslagen" Binding="{Binding ResultsCount}" Width="75"/>
      </DataGrid.Columns></DataGrid>
      <StackPanel Grid.Row="2" Margin="0,16,0,12"><TextBlock x:Name="CategorySourceNote" TextWrapping="Wrap" Margin="0,0,0,8"/><WrapPanel>
       <StackPanel Margin="0,0,16,8"><TextBlock Text="Koppelen aan" Margin="0,0,0,6"/><ComboBox x:Name="CategoryTarget" Width="230" DisplayMemberPath="Name" SelectedValuePath="Key" SelectionChanged="CategoryTargetChanged" IsEnabled="False"/></StackPanel>
       <StackPanel Margin="0,0,16,8"><TextBlock Text="Naam in applicatie" Margin="0,0,0,6"/><TextBox x:Name="CategoryDisplayName" Width="240" MaxLength="100" IsEnabled="False"/></StackPanel>
       <Button x:Name="SaveCategoryButton" Content="Opslaan en opnieuw berekenen" Click="SaveCategory" IsEnabled="False" VerticalAlignment="Bottom" Margin="0,0,0,8" Height="36" Padding="16,6"/>
      </WrapPanel></StackPanel>
     </Grid>
     <Grid x:Name="ConflictPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <WrapPanel><Button x:Name="OptionAButton" Content="Optie A" Click="SameA" IsEnabled="False"/><Button x:Name="OptionBButton" Content="Optie B" Click="SameB" IsEnabled="False"/><Button x:Name="DifferentButton" Content="Verschillend" Click="Different" IsEnabled="False"/><TextBlock x:Name="ConflictSelectionCount" VerticalAlignment="Center" Margin="4,0,20,8"/><Button Content="Keuzes bekijken / herstellen" Click="ReviewDecisions"/><TextBlock Text="Soort" VerticalAlignment="Center" Margin="8,0,8,8"/><ComboBox x:Name="ConflictKindFilter" Width="180" SelectionChanged="ConflictKindChanged" Margin="0,0,0,8"/></WrapPanel>
      <TextBlock Grid.Row="1" Text="Kies per regel of selecteer meerdere regels met Ctrl of Shift en pas de keuze bovenaan toe op de selectie. Optie A/B behoudt de bijbehorende naam en vereniging." TextWrapping="Wrap" Margin="0,6,0,20"/>
      <DataGrid x:Name="ConflictGrid" Grid.Row="2" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="ConflictSelectionChanged" RowHeight="56"><DataGrid.Resources><Style x:Key="CenteredConflictText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="4,0"/></Style></DataGrid.Resources><DataGrid.Columns>
       <DataGridTemplateColumn Header="Keuze" Width="250"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Optie A" Click="RowSameA" Padding="8,5" Margin="2"/><Button Content="Optie B" Click="RowSameB" Padding="8,5" Margin="2"/><Button Content="Verschillend" Click="RowDifferent" Padding="8,5" Margin="2"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="Categorie" Binding="{Binding CategoryLabel}" Width="135" ElementStyle="{StaticResource CenteredConflictText}"/>
       <DataGridTemplateColumn Header="A · deelnemer / vereniging" Width="*" MinWidth="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center" Margin="4,0"><TextBlock Text="{Binding LeftName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LeftName}"/><TextBlock Text="{Binding LeftAssociation}" Foreground="#52636D" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding LeftAssociation}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="B · deelnemer / vereniging" Width="*" MinWidth="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center" Margin="4,0"><TextBlock Text="{Binding RightName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RightName}"/><TextBlock Text="{Binding RightAssociation}" Foreground="#52636D" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding RightAssociation}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="Soort" Binding="{Binding Kind}" Width="120" ElementStyle="{StaticResource CenteredConflictText}"/><DataGridTextColumn Header="Match" Binding="{Binding Score}" Width="65" ElementStyle="{StaticResource CenteredConflictText}"/></DataGrid.Columns></DataGrid>
     </Grid>
     <Grid x:Name="ResultsPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <WrapPanel Margin="0,0,0,18"><TextBlock Text="Wedstrijd" VerticalAlignment="Center" Margin="0,0,12,8"/><ComboBox x:Name="ResultRace" DisplayMemberPath="Label" Width="310" SelectionChanged="FilterChanged" Margin="0,0,20,8"/><TextBlock Text="Categorie" VerticalAlignment="Center" Margin="0,0,12,8"/><ComboBox x:Name="ResultCategory" DisplayMemberPath="Name" SelectedValuePath="Key" Width="240" SelectionChanged="FilterChanged" Margin="0,0,0,8"/></WrapPanel>
      <DataGrid x:Name="ResultsGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" Header="Plaats" Binding="{Binding Rank}" Width="80"/><DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" Header="Deelnemer" Binding="{Binding Name}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" Header="Vereniging" Binding="{Binding Association}" Width="230"/><DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" Header="Tijd" Binding="{Binding Time}" Width="100"/></DataGrid.Columns></DataGrid>
     </Grid>
     <Grid x:Name="StandingPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <DockPanel LastChildFill="True"><Button DockPanel.Dock="Right" x:Name="EditNameButton" Content="Deelnemer wijzigen" Click="EditName" HorizontalAlignment="Right"/><WrapPanel><ComboBox x:Name="StandingCategory" DisplayMemberPath="Name" SelectedValuePath="Key" Width="250" SelectionChanged="FilterChanged" Margin="0,0,16,8"/><StackPanel x:Name="StatusFilterPanel" Orientation="Horizontal"><TextBlock Text="Status" VerticalAlignment="Center" Margin="0,0,8,8"/><ComboBox x:Name="StandingStatusFilter" Width="230" SelectionChanged="FilterChanged" Margin="0,0,16,8"/></StackPanel></WrapPanel></DockPanel>
      <DataGrid x:Name="StandingGrid" Grid.Row="1" Sorting="StandingSorting"><DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding Qualified}" Value="True"><Setter Property="Background" Value="#DCFCE7"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle><DataGrid.Columns>
       <DataGridTemplateColumn x:Name="TeamBreakdownColumn" Header="Puntopbouw" Width="110" Visibility="Collapsed"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Puntopbouw" Click="ShowBreakdown" Padding="8,4" Margin="2" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" Header="Categorie" Binding="{Binding CategoryLabel}" Width="145"/><DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" Header="Plaats" Binding="{Binding Place}" SortMemberPath="Place" Width="60"/><DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" x:Name="NameColumn" Header="Deelnemer" Binding="{Binding Name}" Width="*" MinWidth="180"/><DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" Header="Vereniging" Binding="{Binding Association}" Width="165"/>
       <DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" x:Name="Race1Column" Header="Wedstrijd 1" Binding="{Binding Race1}" SortMemberPath="Race1" Width="105"/><DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" x:Name="Race2Column" Header="Wedstrijd 2" Binding="{Binding Race2}" SortMemberPath="Race2" Width="105"/><DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" x:Name="Race3Column" Header="Wedstrijd 3" Binding="{Binding Race3}" SortMemberPath="Race3" Width="105"/><DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" x:Name="BonusColumn" Header="Bonus" Binding="{Binding Bonus}" Width="65"/><DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" Header="Totaal" Binding="{Binding Total}" Width="65"/><DataGridTextColumn ElementStyle="{StaticResource CenteredTableText}" Header="Status" Binding="{Binding Status}" Width="160"/>
      </DataGrid.Columns></DataGrid>
     </Grid>
          <Grid x:Name="ConfigurationPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="Deze instellingen gelden voor alle poules. De bonus geldt uitsluitend voor het individuele klassement." TextWrapping="Wrap" Margin="0,0,0,20"/>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,32,0"><TextBlock Text="Bonus" FontWeight="SemiBold" FontSize="20" Margin="0,0,0,16"/><TextBlock Text="Bonus vanaf aantal deelnames" Margin="0,0,0,6"/><ComboBox x:Name="BonusStartsInput" Margin="0,0,0,20"/><TextBlock Text="Bonus bij meer dan 10 deelnemers" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBox x:Name="BonusPointsInput" Margin="0,0,0,20"/><TextBlock Text="Bonus bij maximaal 10 deelnemers" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBox x:Name="SmallCategoryBonusPointsInput" Margin="0,0,0,16"/><TextBlock Text="De categoriegrootte is het aantal unieke deelnemers in het eindklassement van de poule." TextWrapping="Wrap" Foreground="#52636D"/></StackPanel>
       <Border Grid.Column="1" BorderBrush="#CAD7DE" BorderThickness="1,0,0,0" Padding="24,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Samengestelde groepen" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,20,0"><TextBlock DockPanel.Dock="Top" Text="Ploegcategorieën" FontWeight="SemiBold" Margin="0,0,0,8"/><WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button Content="Nieuwe groep" Click="NewTeamGroup"/><Button Content="Groep verwijderen" Click="RemoveTeamGroup"/></WrapPanel><ListBox x:Name="TeamGroupsList" DisplayMemberPath="Name" SelectionChanged="TeamGroupSelected"/></DockPanel>
        <DockPanel Grid.Column="1"><TextBlock DockPanel.Dock="Top" Text="Categorieën in de groep" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock DockPanel.Dock="Top" Text="Selecteer minimaal twee categorieën. Categorieën zonder groep blijven afzonderlijk." TextWrapping="Wrap" Margin="0,0,0,8"/><ListBox x:Name="TeamGroupCategories" SelectionMode="Multiple" SelectionChanged="TeamGroupCategoriesChanged"/></DockPanel>
       </Grid></Grid></Border>
      </Grid>
      <Button Grid.Row="2" Content="Opslaan en opnieuw berekenen" Click="SaveConfiguration" HorizontalAlignment="Left" Margin="0,20,0,0"/>
     </Grid>
     <ScrollViewer x:Name="RulesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="RulesContent" Margin="0,0,20,16"/></ScrollViewer>
     <StackPanel x:Name="ExportPanel" Visibility="Collapsed">
      <TextBlock Text="Excel-export per poule" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="Drie tabbladen: uitslagenlijst, individueel klassement en ploegenklassement. Rond de naamcontroles af voordat je exporteert." TextWrapping="Wrap" Margin="0,0,0,16"/>
      <Button Content="Geselecteerde poule exporteren naar Excel" HorizontalAlignment="Left" Click="ExportExcel"/>
     </StackPanel>
    </Grid>
   </Grid>
   <Border x:Name="LoadingPanel" Grid.Column="1" Panel.ZIndex="10" Background="#E6F5F7F8" Visibility="Collapsed"><Border Background="White" CornerRadius="12" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Width="250"><TextBlock Text="Bezig met laden…" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><ProgressBar IsIndeterminate="True" Height="6" Margin="0,20,0,0" AutomationProperties.Name="Pagina wordt geladen"/></StackPanel></Border></Border>
  </Grid>
 </Grid>
</ui:FluentWindow>
